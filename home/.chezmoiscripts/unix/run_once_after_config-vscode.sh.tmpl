#!/usr/bin/env bash

set -eufo pipefail
export PATH="$HOME/.local/bin:${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"

if command -v code >/dev/null 2>&1; then
  bin=$(command -v code || command -v code-insiders || command -v codium)
fi

if [ -n "$bin" ]; then
  echo "Using VSCode binary: $bin"
else
  echo "No VSCode binary found; skipping extension install"
  exit 0
fi

$bin --force {{ range .vscode.extensions }}--install-extension {{ . | quote }} {{ end }}
