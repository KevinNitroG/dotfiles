{{ if eq .osFamily "arch" -}}
#!/usr/bin/env bash

set -eufo pipefail

{{- $cats := list "common" }}
{{- if .isPersonal }}{{ $cats = append $cats "personal" }}{{ end }}
{{- if .isWork }}{{ $cats = append $cats "work" }}{{ end }}
{{- if .isLaptop }}{{ $cats = append $cats "laptop" }}{{ end }}

{{- $pkgs := list }}
{{- range $cat := $cats }}
  {{- $node := index $.pkgs.archBased $cat }}
  {{- $pkgs = concat $pkgs (index $node "cli" | default list) }}
  {{- if $.isGui }}
    {{- $pkgs = concat $pkgs (index $node "gui" | default list) }}
  {{- end }}
{{- end }}
{{- $pkgs = $pkgs | compact | uniq | sortAlpha }}

# Profiles: {{ join ", " .profiles }} | categories: {{ join ", " $cats }} | gui: {{ .isGui }}

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

##########################################

echo 'UPDATING SOURCES...'
{{ $sudo }}pacman -Syu

##########################################

if ! grep -q '^\[chaotic-aur\]' /etc/pacman.conf; then
  echo 'ENABLING CHAOTIC-AUR...'
  chaotic_key=3056513887B78AEB
  if {{ $sudo }}pacman-key --recv-key "$chaotic_key" --keyserver keyserver.ubuntu.com &&
    {{ $sudo }}pacman-key --lsign-key "$chaotic_key" &&
    {{ $sudo }}pacman -U --needed --noconfirm \
      'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
      'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'; then
    printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' |
      {{ $sudo }}tee -a /etc/pacman.conf >/dev/null
    {{ $sudo }}pacman -Sy
  else
    echo '  !! could not enable chaotic-aur; AUR packages will be built from source'
  fi
fi

##########################################

if ! command -v yay &>/dev/null; then
  echo 'INSTALLING YAY...'
  {{ $sudo }}pacman -S --needed git base-devel --noconfirm
  tmp="$(mktemp -d)"
  git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
  (cd "$tmp/yay-bin" && makepkg -si --noconfirm)
  rm -rf "$tmp"
fi

##########################################

{{ if $pkgs -}}
echo 'INSTALLING PACKAGES ({{ len $pkgs }})...'
yay -Syu --needed --noconfirm {{ $pkgs | quoteList | join " " }}
{{- end }}

##########################################

echo 'SETTING UP SERVICES...'
systemctl list-unit-files "cronie.service" &>/dev/null && {{ $sudo }}systemctl enable --now cronie.service

{{ end -}}
