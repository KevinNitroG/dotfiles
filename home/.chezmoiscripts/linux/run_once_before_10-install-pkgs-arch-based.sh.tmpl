#!/usr/bin/env bash
# Install packages on Arch-based distros (Arch, CachyOS, EndeavourOS).
# Package lists live in home/.chezmoidata/pkgs/arch-based.yml.
# Gated to osFamily == "arch" by home/.chezmoiignore.tmpl.

set -eufo pipefail

{{- $cats := list "common" }}
{{- if .isPersonal }}{{ $cats = append $cats "personal" }}{{ end }}
{{- if .isWork }}{{ $cats = append $cats "work" }}{{ end }}
{{- if .isLaptop }}{{ $cats = append $cats "laptop" }}{{ end }}

{{- $pkgs := list }}
{{- range $cat := $cats }}
  {{- $node := index $.pkgs.archBased $cat }}
  {{- $pkgs = concat $pkgs (index $node "cli" | default list) }}
  {{- if $.isGui }}
    {{- $pkgs = concat $pkgs (index $node "gui" | default list) }}
  {{- end }}
{{- end }}
{{- $pkgs = $pkgs | compact | uniq | sortAlpha }}

# Profiles: {{ join ", " .profiles }} | categories: {{ join ", " $cats }} | gui: {{ .isGui }}

##########################################

echo 'UPDATING SOURCES...'
sudo pacman -Sy

if ! command -v yay &>/dev/null; then
  echo 'INSTALLING YAY...'
  sudo pacman -S --needed git base-devel --noconfirm
  tmp="$(mktemp -d)"
  git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
  (cd "$tmp/yay-bin" && makepkg -si --noconfirm)
  rm -rf "$tmp"
fi

##########################################

{{ if $pkgs -}}
echo 'INSTALLING PACKAGES ({{ len $pkgs }})...'
yay -S --needed --noconfirm {{ $pkgs | quoteList | join " " }}
{{- end }}

##########################################

echo 'SETTING UP SERVICES...'
systemctl list-unit-files "cronie.service" &>/dev/null && sudo systemctl enable --now cronie.service
