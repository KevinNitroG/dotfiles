#!/usr/bin/env bash
# Install packages on Ubuntu (including WSL).
# Package lists live in home/.chezmoidata/pkgs/ubuntu-based.yml.
# Gated to osFamily == "ubuntu" by home/.chezmoiignore.tmpl.
#
# Package names are verified against Ubuntu 26.04 LTS.

# NOTE: deliberately not `set -e`. A PPA with no build for this Ubuntu release,
# or a package renamed between releases, must not abort the whole bootstrap —
# failures are collected and reported at the end instead.
set -uo pipefail

export DEBIAN_FRONTEND=noninteractive

{{- $cats := list "common" }}
{{- if .isPersonal }}{{ $cats = append $cats "personal" }}{{ end }}
{{- if .isWork }}{{ $cats = append $cats "work" }}{{ end }}
{{- if .isLaptop }}{{ $cats = append $cats "laptop" }}{{ end }}

{{- $repos := list }}
{{- $aptRepos := list }}
{{- $pkgs := list }}
{{- $scripts := list }}
{{- range $cat := $cats }}
  {{- $node := index $.pkgs.ubuntuBased $cat }}
  {{- $nodeScripts := index $node "scripts" | default dict }}
  {{- $repos = concat $repos (index $node "repositories" | default list) }}
  {{- $nodeAptRepos := index $node "aptRepos" | default dict }}
  {{- $aptRepos = concat $aptRepos (index $nodeAptRepos "cli" | default list) }}
  {{- $scripts = concat $scripts (index $nodeScripts "cli" | default list) }}
  {{- $pkgs = concat $pkgs (index $node "cli" | default list) }}
  {{- if $.isGui }}
    {{- $pkgs = concat $pkgs (index $node "gui" | default list) }}
    {{- $scripts = concat $scripts (index $nodeScripts "gui" | default list) }}
    {{- $aptRepos = concat $aptRepos (index $nodeAptRepos "gui" | default list) }}
  {{- end }}
{{- end }}
{{- $repos = $repos | compact | uniq }}
{{- $aptRepos = $aptRepos | compact }}
{{- $scripts = $scripts | compact | uniq }}
{{- $pkgs = $pkgs | compact | uniq | sortAlpha }}

# Profiles: {{ join ", " .profiles }} | categories: {{ join ", " $cats }} | gui: {{ .isGui }} | wsl: {{ .isWsl }}

SUDO=''
if [ "$(id -u)" -ne 0 ]; then
  SUDO='sudo'
fi

##########################################

echo 'BOOTSTRAPPING APT...'
$SUDO apt-get update
$SUDO apt-get install -y --no-install-recommends \
  ca-certificates curl gnupg software-properties-common

##########################################

{{ if $repos -}}
echo 'ADDING REPOSITORIES...'
# A PPA may have no build for this Ubuntu release, which makes every later
# `apt-get update` fail. Add each one, verify, and roll it back if it breaks.
{{ range $repo := $repos -}}
if $SUDO add-apt-repository -y {{ $repo | quote }}; then
  if ! $SUDO apt-get update >/dev/null 2>&1; then
    echo "  !! {{ $repo }} has no release for $(lsb_release -cs); removing it"
    $SUDO add-apt-repository -y --remove {{ $repo | quote }} >/dev/null 2>&1
  fi
fi
{{ end -}}
{{- end }}

##########################################

{{ if $aptRepos -}}
echo 'ADDING THIRD-PARTY APT REPOS...'
$SUDO install -d -m 0755 /usr/share/keyrings
{{ range $r := $aptRepos -}}
keyring={{ $r.keyring | quote }}
if [ ! -s "$keyring" ]; then
  tmpkey="$(mktemp)"
  if curl -fsSL {{ $r.key | quote }} -o "$tmpkey" && [ -s "$tmpkey" ]; then
    # Accept either an armoured or an already-binary keyring.
    if grep -q 'BEGIN PGP PUBLIC KEY' "$tmpkey" 2>/dev/null; then
      gpg --dearmor <"$tmpkey" | $SUDO tee "$keyring" >/dev/null
    else
      $SUDO cp "$tmpkey" "$keyring"
    fi
    $SUDO chmod 0644 "$keyring"
  else
    echo "  !! could not fetch the {{ $r.name }} signing key; skipping that repo"
  fi
  rm -f "$tmpkey"
fi
if [ -s "$keyring" ]; then
  echo {{ $r.source | quote }} | $SUDO tee "/etc/apt/sources.list.d/{{ $r.name }}.list" >/dev/null
  if ! $SUDO apt-get update >/dev/null 2>&1; then
    echo "  !! the {{ $r.name }} repo is unusable here (no release, or no build for $(dpkg --print-architecture)); removing it"
    $SUDO rm -f "/etc/apt/sources.list.d/{{ $r.name }}.list"
  fi
fi
{{ end -}}
{{- end }}

##########################################

echo 'UPDATING SOURCES...'
$SUDO apt-get update || echo '  !! apt-get update reported errors; continuing'

##########################################

{{ if $pkgs -}}
echo 'INSTALLING PACKAGES ({{ len $pkgs }})...'
# Install one by one so a single package missing from this release does not
# abort the whole bootstrap; failures are reported at the end.
failed=()
for pkg in {{ $pkgs | quoteList | join " " }}; do
  if ! $SUDO apt-get install -y --no-install-recommends "$pkg"; then
    echo "  !! failed: $pkg"
    failed+=("$pkg")
  fi
done
{{- end }}

##########################################

# Ubuntu names some binaries differently from every other distro.
echo 'LINKING DEBIAN-RENAMED BINARIES...'
mkdir -p "$HOME/.local/bin"
[ -x /usr/bin/batcat ] && ln -sf /usr/bin/batcat "$HOME/.local/bin/bat"
[ -x /usr/bin/fdfind ] && ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
true

##########################################

{{ if $scripts -}}
echo 'INSTALLING PACKAGES VIA INSTALLER SCRIPTS...'
{{ range $script := $scripts -}}
curl -fsSL {{ $script | quote }} | sh || echo "  !! failed: {{ $script }}"
{{ end -}}
{{- end }}

##########################################

{{ if $pkgs -}}
if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "PACKAGES THAT FAILED TO INSTALL (${#failed[@]}):"
  printf '  - %s\n' "${failed[@]}"
  echo 'Most tools apt lacks are expected to come from mise instead.'
fi
{{- end }}
