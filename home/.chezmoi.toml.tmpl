{{/* NOTE: this template runs at `chezmoi init` time and CANNOT read .chezmoidata. */}}
{{/*       Anything needed here must be declared inline below.                     */}}

{{/* ------------------------------------------------------------------ */}}
{{/* Static choices                                                      */}}
{{/* ------------------------------------------------------------------ */}}

{{ $themes := list
     "dark"
     "light"
}}
{{ $catppuccinFlavors := list
     "latte"
     "frappe"
     "macchiato"
     "mocha"
}}
{{ $catppuccinAccentColors := list
     "blue"
     "flamingo"
     "green"
     "lavender"
     "maroon"
     "mauve"
     "peach"
     "pink"
     "red"
     "rosewater"
     "sapphire"
     "sky"
     "teal"
     "yellow"
}}

{{/* Known identity profiles. KEEP IN SYNC with home/.chezmoidata/profiles.yml.
     "personal" plus one entry per company (lowercase, no spaces or hyphens). */}}
{{ $knownProfiles := list
     "personal"
     "itcgroup"
}}

{{/* profile -> age identity file. KEEP IN SYNC with profiles.yml ageKeyFile. */}}
{{ $ageKeyFiles := dict
     "personal" ".config/age/key.txt"
     "itcgroup" ".config/age/itcgroup-key.txt"
}}

{{/* profile -> age recipient. KEEP IN SYNC with profiles.yml + global.yml. */}}
{{ $ageRecipients := dict
     "personal" "age1xq0t7wyprw8sqn6w5lqw33wl8kgct32djs7r7jmsgxjj8lqe54vsd76td3"
     "itcgroup" "age1dm6cm48mcsvsw264l702mwfzyhrr74vvcff5dtzj37x2cgy7uu4smuuq7q"
}}

{{/* ------------------------------------------------------------------ */}}
{{/* Defaults                                                            */}}
{{/* ------------------------------------------------------------------ */}}

{{ $shell := "" }}
{{ $terminalFontSize := 13 }}
{{ $opacity := "0.8" }}
{{ $theme := "dark" }}
{{ $catppuccinLightFlavour := "latte" }}
{{ $catppuccinDarkFlavour := "mocha" }}
{{ $catppuccinAccentColor := "lavender" }}
{{ $useHyde := false }}
{{ $isLaptop := false }}
{{ $profiles := list "personal" }}

{{/* ------------------------------------------------------------------ */}}
{{/* Auto-detection (before prompts)                                     */}}
{{/* ------------------------------------------------------------------ */}}

{{/* osId: "windows" | "darwin" | "linux-<osRelease.id>" e.g. "linux-ubuntu" */}}
{{ $osId := .chezmoi.os }}
{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") }}
  {{ $osId = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id }}
{{ end }}

{{/* osFamily: "arch" | "ubuntu" | "windows" | "darwin" | "other".
     Drives which package manager / install script is used.
     Only Ubuntu and its derivatives (Mint, Pop!_OS — ID_LIKE=ubuntu) map to
     "ubuntu"; plain Debian is not supported and falls through to "other",
     which simply means no package installer runs. */}}
{{ $osFamily := "other" }}
{{ if eq .chezmoi.os "windows" }}
  {{ $osFamily = "windows" }}
{{ else if eq .chezmoi.os "darwin" }}
  {{ $osFamily = "darwin" }}
{{ else if eq .chezmoi.os "linux" }}
  {{ $idLike := "" }}
  {{ if hasKey .chezmoi.osRelease "idLike" }}{{ $idLike = .chezmoi.osRelease.idLike }}{{ end }}
  {{ $distroId := "" }}
  {{ if hasKey .chezmoi.osRelease "id" }}{{ $distroId = .chezmoi.osRelease.id }}{{ end }}
  {{ $distroIds := lower (printf "%s %s" $distroId $idLike) }}
  {{ if or (contains "arch" $distroIds) (contains "cachyos" $distroIds) (contains "endeavouros" $distroIds) }}
    {{ $osFamily = "arch" }}
  {{ else if contains "ubuntu" $distroIds }}
    {{ $osFamily = "ubuntu" }}
  {{ end }}
{{ end }}

{{/* WSL: the kernel release carries "microsoft" under WSL1 and WSL2. */}}
{{ $isWsl := false }}
{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") }}
  {{ if contains "microsoft" (lower (.chezmoi.kernel.osrelease | default "")) }}
    {{ $isWsl = true }}
  {{ end }}
{{ end }}

{{/* Headless (no desktop): WSL, containers and servers get no terminal
     emulators, fonts, input methods or GUI apps. */}}
{{ $isGui := true }}
{{ if $isWsl }}
  {{ $isGui = false }}
{{ else if eq .chezmoi.os "linux" }}
  {{ if not (or (env "DISPLAY") (env "WAYLAND_DISPLAY") (env "XDG_SESSION_TYPE")) }}
    {{ $isGui = false }}
  {{ end }}
{{ end }}

{{ if eq $osFamily "windows" }}
  {{ $shell = "pwsh" }}
{{ else }}
  {{ $shell = "zsh" }}
{{ end }}

{{/* Laptop power tooling is meaningless under WSL / in containers. */}}
{{ if lookPath "hostnamectl" }}
  {{ if eq (output "hostnamectl" "chassis" | trim) "laptop" }}
    {{ $isLaptop = true }}
  {{ end }}
{{ else if lookPath "wmic" }}
  {{ if eq (output "wmic" "computersystem" "get" "PCSystemType" "/VALUE" | trim) "PCSystemType=2" }}
    {{ $isLaptop = true }}
  {{ end }}
{{ end }}
{{ if $isWsl }}{{ $isLaptop = false }}{{ end }}

{{/* ------------------------------------------------------------------ */}}
{{/* Prompts                                                             */}}
{{/* ------------------------------------------------------------------ */}}

{{/* Seed every prompt's DEFAULT from the answer already in
     ~/.config/chezmoi/chezmoi.toml, when there is one.

     This is what makes re-running `chezmoi init` non-destructive, and it is
     not redundant with the prompt defaults below: those are the *first-run*
     defaults (dark/mocha/personal). Without this block, the re-init that
     docs/new-company.md requires — and any re-init after adding an age key —
     would silently reset your theme, flavour, accent, font size and profiles
     back to factory values.

     It is deliberately NOT promptStringOnce/promptBoolOnce: those never ask
     again once a value exists, so you could only change an answer by hand-
     editing the config. Here you are re-asked, with your previous answer
     pre-filled — press Enter to keep it. */}}
{{ if hasKey . "profiles" }}{{ $profiles = .profiles }}{{ end }}
{{ if hasKey . "isGui" }}{{ $isGui = .isGui }}{{ end }}
{{ if hasKey . "isLaptop" }}{{ $isLaptop = .isLaptop }}{{ end }}
{{ if hasKey . "useHyde" }}{{ $useHyde = .useHyde }}{{ end }}
{{ if hasKey . "theme" }}{{ $theme = .theme }}{{ end }}
{{ if hasKey . "opacity" }}{{ $opacity = printf "%v" .opacity }}{{ end }}
{{ if hasKey . "terminalFontSize" }}{{ $terminalFontSize = .terminalFontSize }}{{ end }}
{{ if hasKey . "catppuccinLightFlavour" }}{{ $catppuccinLightFlavour = .catppuccinLightFlavour }}{{ end }}
{{ if hasKey . "catppuccinDarkFlavour" }}{{ $catppuccinDarkFlavour = .catppuccinDarkFlavour }}{{ end }}
{{ if hasKey . "catppuccinAccentColor" }}{{ $catppuccinAccentColor = .catppuccinAccentColor }}{{ end }}

{{/* Prompt names are kept short and stable so they can be scripted, e.g.
     chezmoi init --promptString profiles=personal,itcgroup --promptBool isGui=false
     Available profiles: {{ join ", " $knownProfiles }} */}}
{{/* prompt* returns the default when stdin is not a TTY, so this block is
     safe non-interactively (CI, containers, --promptString overrides). */}}
{{/* Profiles is a LIST, not a single choice: a work laptop normally carries
     both "personal" and the company, since the personal GitHub account still
     gets used from work. chezmoi has no multi-select prompt and promptChoice
     takes a single value, so this stays a comma-separated string -- but the
     valid names are printed first and every entry is validated below, so a
     typo fails loudly at init instead of silently producing a machine with no
     git identity. */}}
{{ if stdinIsATTY }}
  {{ writeToStdout (printf "\nProfiles available: %s\n  one or more, comma separated (a work machine is usually \"personal,<company>\")\n\n" (join ", " $knownProfiles)) }}
{{ end }}
{{ $profiles = splitList "," (promptString "profiles" (join "," $profiles)) }}
{{ $isGui = promptBool "isGui" $isGui }}
{{ if not $isWsl }}
  {{ $isLaptop = promptBool "isLaptop" $isLaptop }}
{{ end }}

{{ if $isGui }}
  {{ $terminalFontSize = promptInt "terminalFontSize" $terminalFontSize }}
  {{ $opacity = promptString "opacity" $opacity }}
{{ end }}

{{ $theme = promptChoice "theme" $themes $theme }}
{{ $catppuccinLightFlavour = promptChoice "catppuccinLightFlavour" $catppuccinFlavors $catppuccinLightFlavour }}
{{ $catppuccinDarkFlavour = promptChoice "catppuccinDarkFlavour" $catppuccinFlavors $catppuccinDarkFlavour }}
{{ $catppuccinAccentColor = promptChoice "catppuccinAccentColor" $catppuccinAccentColors $catppuccinAccentColor }}

{{/* HyDE is an Arch-only Hyprland desktop; pointless on work/WSL/headless. */}}
{{ if and (eq $osFamily "arch") $isGui (not $isWsl) (has "personal" $profiles) }}
  {{ $useHyde = promptBool "useHyde" $useHyde }}
{{ end }}

{{/* Normalise whatever came back from the prompt / previous config. */}}
{{ $cleaned := list }}
{{ range $profiles }}{{ $cleaned = append $cleaned (trim .) }}{{ end }}
{{ $profiles = $cleaned | compact | uniq }}
{{ if not $profiles }}{{ $profiles = list "personal" }}{{ end }}

{{/* Reject unknown names rather than carrying them into [data], where they
     would blow up later in any template that does `index .profileDefs $name`. */}}
{{ range $profiles }}
  {{ if not (has . $knownProfiles) }}
    {{ fail (printf "unknown profile %q -- valid profiles are: %s (add a new one in home/.chezmoidata/profiles.yml and $knownProfiles here; see docs/new-company.md)" . (join ", " $knownProfiles)) }}
  {{ end }}
{{ end }}

{{/* ------------------------------------------------------------------ */}}
{{/* Derived                                                             */}}
{{/* ------------------------------------------------------------------ */}}

{{/* Companies = every profile that is not "personal". `company` is the primary
     (first) one, or "" on a personal-only machine. */}}
{{ $companies := without $profiles "personal" }}
{{ $company := "" }}
{{ if $companies }}
  {{ $company = first $companies }}
{{ end }}
{{ $isWork := gt (len $companies) 0 }}
{{ $isPersonal := has "personal" $profiles }}

{{ $catppuccinFlavor := $catppuccinDarkFlavour }}
{{ if eq $theme "light" }}
  {{ $catppuccinFlavor = $catppuccinLightFlavour }}
{{ end }}

{{ $transparent := ne $opacity "1" }}

{{/* Identities: only the private key files this machine actually has, for the
     profiles it carries. Add a key later => re-run `chezmoi init`. */}}
{{ $identities := list }}
{{ range $profiles }}
  {{ if hasKey $ageKeyFiles . }}
    {{ $f := joinPath $.chezmoi.homeDir (get $ageKeyFiles .) }}
    {{ if lstat $f }}
      {{ $identities = append $identities $f }}
    {{ end }}
  {{ end }}
{{ end }}

{{/* Recipients: ALWAYS every known recipient, regardless of the profiles on
     this machine. Otherwise a `chezmoi re-add` on a work-only box would
     re-encrypt files so the personal key can no longer read them. */}}
{{ $recipients := list }}
{{ range $knownProfiles }}
  {{ if hasKey $ageRecipients . }}
    {{ $recipients = append $recipients (get $ageRecipients .) }}
  {{ end }}
{{ end }}

{{/* ------------------------------------------------------------------ */}}
{{/* Output                                                              */}}
{{/* ------------------------------------------------------------------ */}}

encryption = "age"
mode = "file" # file, symlink
progress = true

[data]
profiles = [ {{ $profiles | quoteList | join ", " }} ]
companies = [ {{ $companies | quoteList | join ", " }} ]
company = {{ $company | quote }}
isWork = {{ $isWork }}
isPersonal = {{ $isPersonal }}
osId = {{ $osId | quote }}
osFamily = {{ $osFamily | quote }}
isWsl = {{ $isWsl }}
isGui = {{ $isGui }}
isLaptop = {{ $isLaptop }}
useHyde = {{ $useHyde }}
terminalFontSize = {{ $terminalFontSize }}
opacity = {{ $opacity }}
transparent = {{ $transparent }}
theme = {{ $theme | quote }}
catppuccinLightFlavour = {{ $catppuccinLightFlavour | quote }}
catppuccinDarkFlavour = {{ $catppuccinDarkFlavour | quote }}
catppuccinFlavor = {{ $catppuccinFlavor | quote }}
catppuccinFlavorTitle = {{ $catppuccinFlavor | title | quote }}
catppuccinAccentColor = {{ $catppuccinAccentColor | quote }}

[data.catppuccin]
accentColors = [ {{ $catppuccinAccentColors | quoteList | join ", " }} ]
flavors = [ {{ $catppuccinFlavors | quoteList | join ", " }} ]

[age]
armor = true # keep encrypted files as text so git diffs stay sane
identities = [ {{ $identities | quoteList | join ", " }} ]
recipients = [ {{ $recipients | quoteList | join ", " }} ]

[git]
autoAdd = true # Add changes to the source state after any change
autoCommit = false
autoPush = false

[cd]
command = {{ $shell | quote }}

[completion]
custom = true

[edit]
command = "nvim"

[diff]
command = "delta"
pager = "delta"
args = ["--paging=never"]

[merge]
command = "nvim"
args = ["-d", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]
