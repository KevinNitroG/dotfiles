{{/* Runs at `chezmoi init`, which CANNOT read .chezmoidata -- hence $profileMeta
     below. It is the SINGLE source of truth for age keys and recipients:
     everything else reads them back from the rendered config via
     .chezmoi.config.age.*, so there is nothing to keep in sync. */}}

{{/* ---------- choices ---------- */}}

{{ $themes := list "dark" "light" }}
{{ $catppuccinFlavors := list "latte" "frappe" "macchiato" "mocha" }}
{{ $catppuccinAccentColors := list
     "blue" "flamingo" "green" "lavender" "maroon" "mauve" "peach"
     "pink" "red" "rosewater" "sapphire" "sky" "teal" "yellow" }}

{{/* One entry per identity: "personal" plus one per company (lowercase, no
     spaces or hyphens). Adding one here is step 3a of docs/new-company.md.
     "ephemeral" is the keyless guest identity: no age key, no ssh key, no git
     identity, no secrets. Empty "key"/"recipient" means exactly that and is
     skipped in both loops below. */}}
{{ $profileMeta := dict
     "personal" (dict
       "key" ".config/age/key.txt"
       "recipient" "age1xq0t7wyprw8sqn6w5lqw33wl8kgct32djs7r7jmsgxjj8lqe54vsd76td3")
     "itcgroup" (dict
       "key" ".config/age/itcgroup-key.txt"
       "recipient" "age1dm6cm48mcsvsw264l702mwfzyhrr74vvcff5dtzj37x2cgy7uu4smuuq7q")
     "ephemeral" (dict
       "key" ""
       "recipient" "")
}}
{{/* personal first, then companies alphabetically, ephemeral last */}}
{{ $knownProfiles := concat
     (list "personal")
     (sortAlpha (without (keys $profileMeta) "personal" "ephemeral"))
     (list "ephemeral") }}

{{/* ---------- detect ---------- */}}

{{/* "windows" | "darwin" | "linux-<osRelease.id>" */}}
{{ $osId := .chezmoi.os }}
{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") }}
  {{ $osId = printf "linux-%s" .chezmoi.osRelease.id }}
{{ end }}

{{/* Picks the package installer. One of:
     "arch" | "ubuntu" | "fedora" | "windows" | "darwin" | "other".
     Debian deliberately does not map to "ubuntu": its package set differs and
     PPAs do not resolve there, so it lands in "other", which simply means no
     installer runs. */}}
{{ $osFamily := "other" }}
{{ if eq .chezmoi.os "windows" "darwin" }}
  {{ $osFamily = .chezmoi.os }}
{{ else if eq .chezmoi.os "linux" }}
  {{ $ids := lower (printf "%s %s"
       (dig "id" "" .chezmoi.osRelease) (dig "idLike" "" .chezmoi.osRelease)) }}
  {{ if or (contains "arch" $ids) (contains "cachyos" $ids) (contains "endeavouros" $ids) }}
    {{ $osFamily = "arch" }}
  {{ else if contains "ubuntu" $ids }}
    {{ $osFamily = "ubuntu" }}
  {{/* idLike catches the rebuilds: Nobara and Bazzite say "fedora", while
       RHEL/CentOS/Rocky/Alma say "rhel" (usually "... rhel fedora"). */}}
  {{ else if or (contains "fedora" $ids) (contains "rhel" $ids) }}
    {{ $osFamily = "fedora" }}
  {{ end }}
{{ end }}

{{/* WSL1 and WSL2 both carry "microsoft" in the kernel release. */}}
{{ $isWsl := contains "microsoft" (lower (dig "kernel" "osrelease" "" .chezmoi)) }}

{{/* Headless (WSL, containers, servers): no terminals, fonts, input methods
     or GUI apps. */}}
{{ $isGui := true }}
{{ if $isWsl }}
  {{ $isGui = false }}
{{ else if eq .chezmoi.os "linux" }}
  {{ $isGui = not (not (or (env "DISPLAY") (env "WAYLAND_DISPLAY") (env "XDG_SESSION_TYPE"))) }}
{{ end }}

{{ $isLaptop := false }}
{{ if lookPath "hostnamectl" }}
  {{ $isLaptop = eq (output "hostnamectl" "chassis" | trim) "laptop" }}
{{ else if lookPath "wmic" }}
  {{ $isLaptop = eq (output "wmic" "computersystem" "get" "PCSystemType" "/VALUE" | trim) "PCSystemType=2" }}
{{ end }}
{{ if $isWsl }}{{ $isLaptop = false }}{{ end }}

{{/* ---------- prompts ---------- */}}

{{/* Every default is read back from the existing chezmoi.toml via `dig`, so
     re-running `chezmoi init` (which docs/new-company.md requires) re-asks with
     your previous answer pre-filled rather than resetting to factory values.
     Not promptXOnce: those never ask again once a value exists.
     Names are short and stable so they can be scripted:
       chezmoi init --promptDefaults --promptChoice profile=itcgroup */}}

{{/* ONE identity per machine. A company machine is a company machine: it does
     not carry the personal git identity, the personal ssh key or any personal
     secret. Its own GitHub account, if it has one, is declared in that
     profile's own block in .chezmoidata/profiles.yml.
     promptChoice rejects unknown names, so a typo cannot reach [data] and fail
     later in `index .profileDefs $profile`. The stored value is checked first,
     or a since-removed company would make the default invalid and init would
     refuse to start. */}}
{{ $stored := dig "profile" "personal" . }}
{{ if not (has $stored $knownProfiles) }}{{ $stored = "personal" }}{{ end }}
{{/* the prompt TEXT is the key `--promptChoice` matches on, hence "profile" */}}
{{ $profile := promptChoice "profile" $knownProfiles $stored }}

{{ $isGui = promptBool "Is this machine GUI" (dig "isGui" $isGui .) }}
{{ if not $isWsl }}
  {{ $isLaptop = promptBool "Is this a laptop" (dig "isLaptop" $isLaptop .) }}
{{ end }}

{{ $terminalFontSize := dig "terminalFontSize" 13 . | int64 }}
{{ $opacity := printf "%v" (dig "opacity" "0.8" .) }}
{{ if $isGui }}
  {{ $terminalFontSize = promptInt "Terminal font size" $terminalFontSize | int64 }}
  {{ $opacity = promptString "Opacity" $opacity }}
{{ end }}

{{ $theme := promptChoice "What theme to use" $themes (dig "theme" "dark" .) }}
{{ $catppuccinLightFlavour := promptChoice "catppuccin light flavour" $catppuccinFlavors (dig "catppuccinLightFlavour" "latte" .) }}
{{ $catppuccinDarkFlavour := promptChoice "catppuccin dark flavour" $catppuccinFlavors (dig "catppuccinDarkFlavour" "mocha" .) }}
{{ $catppuccinAccentColor := promptChoice "catppuccin accentColor" $catppuccinAccentColors (dig "catppuccinAccentColor" "lavender" .) }}

{{/* HyDE is an Arch-only Hyprland desktop; pointless on work/WSL/headless. */}}
{{ $useHyde := false }}
{{ if and (eq $osFamily "arch") $isGui (not $isWsl) (eq $profile "personal") }}
  {{ $useHyde = promptBool "detect Arch based Linux, use hyde" (dig "useHyde" false .) }}
{{ end }}

{{/* ---------- derive ---------- */}}

{{ $isPersonal := eq $profile "personal" }}
{{/* "ephemeral" is neither personal nor work: it is a guest/throwaway box that
     carries no identity at all, so it must not pull the work package set or
     the work zsh plugins either. */}}
{{ $isEphemeral := eq $profile "ephemeral" }}
{{ $isWork := and (not $isPersonal) (not $isEphemeral) }}
{{ $company := ternary $profile "" $isWork }}
{{ $catppuccinFlavor := ternary $catppuccinLightFlavour $catppuccinDarkFlavour (eq $theme "light") }}

{{/* identities: this profile's key, and only if the file actually exists --
     drop a key in later => re-run `chezmoi init`. An empty list is a supported
     state, not an error: .chezmoiignore.tmpl skips every encrypted target when
     there is no identity, so `chezmoi apply` still works on a fresh machine.
     recipients: ALWAYS all of them, including ones this machine cannot read,
     or `chezmoi re-add` on a work box would re-encrypt files so the personal
     key could no longer decrypt them. */}}
{{ $identities := list }}
{{ $recipients := list }}
{{ range $name := $knownProfiles }}
  {{ $meta := get $profileMeta $name }}
  {{ if $meta.recipient }}
    {{ $recipients = append $recipients $meta.recipient }}
  {{ end }}
  {{ if $meta.key }}
    {{ $f := joinPath $.chezmoi.homeDir $meta.key }}
    {{ if and (eq $name $profile) (lstat $f) }}
      {{ $identities = append $identities $f }}
    {{ end }}
  {{ end }}
{{ end }}

{{/* ---------- output ---------- */}}

{{/* Always set, even with no identity: it is what makes chezmoi strip the
     `encrypted_` attribute and the `.age` suffix when mapping source names to
     target paths. Unset it and `encrypted_private_dot_npmrc.age` becomes a
     literal `~/.npmrc.age` that no .chezmoiignore entry matches. */}}
encryption = "age"
mode = "file" # file, symlink
progress = "auto" # "true" forces a progress bar, which needs a TTY and aborts in CI/containers

[data]
profile = {{ $profile | quote }}
company = {{ $company | quote }}
isWork = {{ $isWork }}
isPersonal = {{ $isPersonal }}
isEphemeral = {{ $isEphemeral }}
osId = {{ $osId | quote }}
osFamily = {{ $osFamily | quote }}
isWsl = {{ $isWsl }}
isGui = {{ $isGui }}
isLaptop = {{ $isLaptop }}
useHyde = {{ $useHyde }}
terminalFontSize = {{ $terminalFontSize }}
opacity = {{ $opacity }}
transparent = {{ ne $opacity "1" }}
theme = {{ $theme | quote }}
catppuccinLightFlavour = {{ $catppuccinLightFlavour | quote }}
catppuccinDarkFlavour = {{ $catppuccinDarkFlavour | quote }}
catppuccinFlavor = {{ $catppuccinFlavor | quote }}
catppuccinFlavorTitle = {{ $catppuccinFlavor | title | quote }}
catppuccinAccentColor = {{ $catppuccinAccentColor | quote }}

[data.catppuccin]
accentColors = [ {{ $catppuccinAccentColors | quoteList | join ", " }} ]
flavors = [ {{ $catppuccinFlavors | quoteList | join ", " }} ]

[age]
armor = true # keep encrypted files as text so git diffs stay sane
identities = [ {{ $identities | quoteList | join ", " }} ]
recipients = [ {{ $recipients | quoteList | join ", " }} ]

[git]
autoAdd = true # Add changes to the source state after any change
autoCommit = false
autoPush = false

[cd]
command = {{ ternary "pwsh" "zsh" (eq $osFamily "windows") | quote }}

[completion]
custom = true

[edit]
command = "nvim"

[diff]
command = "delta"
pager = "delta"
args = ["--paging=never"]

[merge]
command = "nvim"
args = ["-d", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]
