{{- $p := index .ctx.profileDefs .profile -}}
# vim:ft=gitconfig
# GENERATED from home/.chezmoidata/profiles.yml -> profileDefs.{{ .profile }}
# Do not edit by hand; edit profiles.yml and re-run `chezmoi apply`.

[user]
  name = {{ $p.gitName }}
  email = {{ $p.gitEmail }}
{{- if eq $p.signing "gpg" }}
  signingkey = {{ $p.gpgKey }}

[gpg]
  format = openpgp
  program = gpg
{{- else if eq $p.signing "ssh" }}
  signingkey = {{ $p.sshKey }}.pub

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}

[commit]
  gpgsign = {{ if $p.signing }}true{{ else }}false{{ end }}

[tag]
  gpgsign = {{ if $p.signing }}true{{ else }}false{{ end }}
