# vim:ft=sshconfig.chezmoitmpl
#
# The forge blocks below are GENERATED from profileDefs.{{ .profile }}.sshHosts in
# home/.chezmoidata/profiles.yml. No host is hardcoded to a particular
# identity: github.com is an sshHosts entry like any other, so on a company
# machine it authenticates with the COMPANY key.
{{- $p := index .profileDefs .profile }}

Host *
  ServerAliveInterval 86400
  ServerAliveCountMax 4
  Port 22
{{- if $p.sshKey }}
  IdentityFile {{ $p.sshKey }}
{{- end }}
{{ range $h := ($p.sshHosts | default list) }}
Host {{ $h.name }}
  HostName {{ $h.hostName }}
  User {{ $h.user }}
  PreferredAuthentications publickey
  IdentityFile {{ $p.sshKey }}
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
{{ end }}
{{ if .isPersonal }}
Host ngen
  HostName ntgnguyen.tailf6edf3.ts.net
  User ntgnguyen
  Port 22

Host idx
  HostName idx-as
  User user

# Host kevblink
#   HostName ssh-kevblink.kevinnitro.id.vn
#   User kevinnitro

# My modem?
Host 192.168.1.1
  HostKeyAlgorithms=+ssh-rsa
  PubkeyAcceptedAlgorithms=+ssh-rsa

Host 192.168.28.*
  SetEnv TERM=screen-256color # Set term for it
  StrictHostKeyChecking no # Disable host key verification
  UserKnownHostsFile /dev/null # Prevent adding to known_hosts file

Host kevblink
  User kevinnitro
  HostName 192.168.28.25

Host kevblink-cloudflare
  User kevinnitro
  HostName 192.0.1.1
{{ end }}
