[wsl2]
# memory=6GB
processors=4
localhostForwarding = true
safeMode = false
# pageReporting = true
guiApplications = true
debugConsole = false
vmIdleTimeout = 60000
networkingMode = mirrored # nat, or consomme
firewall = true
dnsTunneling = false
autoProxy = false
# useWindowsDnsCache = false # require experimental.dnsTunneling
telemetry = false

[user]
default = kevinnitro

[boot]
systemd = true

[experimental]
autoMemoryReclaim = gradual
sparseVhd = false

