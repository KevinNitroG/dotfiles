#:schema https://mise.jdx.dev/schema/mise.json
#
# Edit tools directly in this file. Profile/machine gating is done inline with
# chezmoi template conditionals:
#
#   {{ "{{" }} if .isPersonal {{ "}}" }} ... {{ "{{" }} end {{ "}}" }}   personal machines
#   {{ "{{" }} if .isWork {{ "}}" }}     ... {{ "{{" }} end {{ "}}" }}   machines with a company profile
#   {{ "{{" }} if .isGui {{ "}}" }}      ... {{ "{{" }} end {{ "}}" }}   desktops only (not WSL / servers)
#
# NOTE: mise has its own {{ "{{" }} ... {{ "}}" }} syntax, which chezmoi would eat.
# Escape literal mise templates — see the mcp-grafana asset_pattern below.
#
# Profiles on this machine: {{ join ", " .profiles }} | gui: {{ .isGui }}

[tool_alias]
nix = "https://github.com/mise-plugins/mise-nix.git"
# nix = "https://github.com/jbadeau/mise-nix.git"

[tools]
python = "3.13.12"
pnpm = "latest"
cmctl = "latest"
"npm:typescript" = "latest"
"npm:ctx7" = "latest"
"npm:skills" = "latest"
"go:gotest.tools/gotestsum" = "latest"
"go:github.com/dolmen-go/docker-list-context" = "latest"
"github:felangga/chiko" = "latest"
"github:cloudnative-pg/cloudnative-pg" = "latest"
"github:rcieri/glab-tui" = "latest"
{{- if .isPersonal }}
"pipx:codecov-cli" = "latest"
{{- end }}
{{- if eq .osFamily "ubuntu" }}

yq = "latest" # apt's `yq` is python-yq, not mikefarah/yq
usage = "latest" # mise completions
kubectl = "latest"
helm = "latest"
flux2 = "latest"
sops = "latest"
bun = "latest"
uv = "latest"
"github:jesseduffield/lazydocker" = "latest"
"github:mr-karan/doggo" = "latest"
"github:dlvhdr/diffnav" = "latest"
"htmlq" = "latest"
"websocat" = "latest"
"npm:@ast-grep/cli" = "latest"
"npm:@mermaid-js/mermaid-cli" = "latest"
"npm:opencode-ai" = "latest"
"npm:@anthropic-ai/claude-code" = "latest"
"pipx:markitdown" = "latest"
"aqua:zaghaghi/openapi-tui" = "latest" # no short registry name
"github:jonas-grgt/ktea" = "latest"
"github:jorgerojas26/lazysql" = "latest"
"github:rtk-ai/rtk" = "latest"
"github:dlvhdr/gh-dash" = "latest"
"github:rustfs/cli" = "latest"
{{- if .isPersonal }}
"github:da-luce/astroterm" = "latest"
"github:nickvanw/qbittorrent-tui" = "latest"
{{- end }}
{{- end }}
{{- if eq .osFamily "fedora" }}

# dnf HAS yq (mikefarah), helm, uv and astroterm, so those are deliberately
# absent here. Everything below has no Fedora package at all.
usage = "latest" # mise completions
kubectl = "latest" # dnf only ships versioned kubernetesN.NN-client
flux2 = "latest"
sops = "latest"
bun = "latest"
kubecolor = "latest"
xh = "latest"
dust = "latest"
jqp = "latest"
"aqua:dalance/procs" = "latest" # no short registry name
# dysk ships ONE arch-less zip with per-triple subdirs, so it needs bin_path.
# aqua: installs it but exposes no binary, and ubi: picks the macOS build.
# NOTE: bin_path below uses mise's own template syntax, escaped so that
# chezmoi passes it through rather than evaluating it (see mcp-grafana).
"github:Canop/dysk" = { version = "latest", bin_path = "{{ "{{" }}arch(x64='x86_64', arm64='aarch64'){{ "}}" }}-unknown-linux-gnu" }
# tmuxinator stays on gem: — upstream publishes only a .gem, which is a ruby
# package, not an executable, so there is no prebuilt binary to use instead.
"gem:tmuxinator" = "latest"
"github:jesseduffield/lazydocker" = "latest"
"github:mr-karan/doggo" = "latest"
"github:dlvhdr/diffnav" = "latest"
"htmlq" = "latest"
"websocat" = "latest"
"npm:@ast-grep/cli" = "latest"
"npm:@mermaid-js/mermaid-cli" = "latest"
"npm:opencode-ai" = "latest"
"npm:@anthropic-ai/claude-code" = "latest"
"pipx:markitdown" = "latest"
"aqua:zaghaghi/openapi-tui" = "latest" # no short registry name
"github:jonas-grgt/ktea" = "latest"
"github:jorgerojas26/lazysql" = "latest"
"github:rtk-ai/rtk" = "latest"
"github:dlvhdr/gh-dash" = "latest"
"github:rustfs/cli" = "latest"
{{- if .isPersonal }}
"github:nickvanw/qbittorrent-tui" = "latest"
{{- end }}
{{- end }}

{{ if or (eq .osFamily "ubuntu") (eq .osFamily "fedora") -}}
[tools."github:vercel-labs/agent-browser"]
version = "latest"
rename_exe = "agent-browser"

[tools."github:dlvhdr/gh-enhance"]
version = "latest"
rename_exe = "gh-enhance"

{{ end -}}
[tools."github:wakatime/wakatime-cli"]
version = "latest"
rename_exe = "wakatime-cli"

[tools."github:grafana/alloy"]
version = "latest"
rename_exe = "alloy"

[tools."github:grafana/mcp-grafana"]
version = "0.11.6"
asset_pattern = "mcp-grafana_{{ "{{" }}os(macos='Darwin', linux='Linux', windows='Windows'){{ "}}" }}_{{ "{{" }}arch(x64='x86_64', arm64='arm64'){{ "}}" }}.*"

[settings]
idiomatic_version_file_enable_tools = ["dotnet"]
experimental = true
pipx.uvx = true

[hooks]
enter = "mise i -q"

[shell_alias]
renovate = "mise exec npm:renovate@latest npm:node@24 -- renovate"
"renovate-config-validator" = "mise exec npm:renovate@latest npm:node@24 -- renovate-config-validator"
"oh-my-opencode-slim" = "mise exec npm:oh-my-opencode-slim@latest -- oh-my-opencode-slim"
