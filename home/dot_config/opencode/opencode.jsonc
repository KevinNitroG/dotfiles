{
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "autoupdate": false,
  "default_agent": "build",
  "agent": {
    "compaction": {
      "model": "opencode/muse-spark-1.3-contributor-free",
    },
    "build": {
      "model": "opencode/muse-spark-1.3-contributor-free",
    },
    "plan": {
      "model": "opencode/muse-spark-1.3-contributor-free",
    },
    "general": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "title": {
      "model": "opencode/hy3-free",
    },
  },
  "plugin": [
    "@wakatime/opencode-wakatime",
    "@tarquinen/opencode-dcp@latest",
    {
      "package": "opencode-pty/v2",
    },
    "oh-my-opencode-slim",
  ],
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:chrome-devtools-mcp@latest",
          "--",
          "chrome-devtools-mcp",
          "--no-usage-statistics",
          "--autoConnect=true",
          "--userDataDir=/home/kevinnitro/.config/BraveSoftware/Brave-Browser",
          "--experimentalScreencast=true",
          "--experimentalDevtools=true",
        ],
        "disabled": true,
      },
      "chrome-devtools-isolate": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:chrome-devtools-mcp@latest",
          "--",
          "chrome-devtools-mcp",
          "--no-usage-statistics",
          "--executablePath",
          "/usr/bin/brave",
          "--isolated=true",
          "--experimentalScreencast=true",
          "--experimentalDevtools=true",
        ],
        "disabled": true,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
        "disabled": false,
      },
      "ddg-search": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "pipx:duckduckgo-mcp-server@latest",
          "--",
          "duckduckgo-mcp-server",
        ],
        "disabled": true,
      },
      "brave-search": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:@brave/brave-search-mcp-server@latest",
          "--",
          "brave-search-mcp-server",
        ],
        "environment": {
          "BRAVE_SEARCH_API_KEY": "{env:BRAVE_SEARCH_API_KEY}",
        },
        "disabled": true,
      },
      "fetch": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:mcp-fetch-server@latest",
          "--",
          "mcp-fetch-server",
        ],
        "disabled": true,
      },
      "filesystem": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:@modelcontextprotocol/server-filesystem@latest",
          "--",
          "mcp-server-filesystem",
          "~/",
        ],
        "disabled": true,
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}",
        },
      },
      "google-sheets": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "pipx:mcp-google-sheets@latest",
          "--",
          "mcp-google-sheets",
        ],
        "disabled": true,
        "environment": {
          "CREDENTIALS_PATH": "${HOME}/.config/mcp/mcp-google-sheet/credentials.json",
          "TOKEN_PATH": "${HOME}/.config/mcp/mcp-google-sheet/token.json",
        },
      },
      "kubernetes": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:mcp-server-kubernetes@latest",
          "--",
          "mcp-server-kubernetes",
        ],
        "disabled": true,
      },
      "memory": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:@modelcontextprotocol/server-memory@latest",
          "--",
          "server-memory",
        ],
        "disabled": true,
      },
      "playwright": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:@playwright/mcp@latest",
          "--",
          "playwright-mcp",
          "--config",
          "/home/kevinnitro/.config/playwright-mcp.json",
        ],
        "disabled": true,
        "environment": {
          "WAYLAND_DISPLAY": "{env:WAYLAND_DISPLAY}",
          "XDG_RUNTIME_DIR": "{env:XDG_RUNTIME_DIR}",
        },
      },
      "puppeteer": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:@modelcontextprotocol/server-puppeteer@latest",
          "--",
          "server-puppeteer",
        ],
        "disabled": true,
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:@modelcontextprotocol/server-sequential-thinking@latest",
          "--",
          "server-sequential-thinking",
        ],
        "disabled": true,
      },
      "tavily": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:tavily-mcp@latest",
          "--",
          "tavily-mcp",
        ],
        "disabled": true,
        "environment": {
          "TAVILY_API_KEY": "{env:TAVILY_API_KEY}",
        },
      },
      "time": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "pipx:mcp-server-time@latest",
          "--",
          "mcp-server-time",
          "--local-timezone=Asia/Ho_Chi_Minh",
        ],
        "disabled": true,
      },
      "Framelink_Figma_MCP": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:figma-developer-mcp@latest",
          "--",
          "figma-developer-mcp",
          "--stdio",
        ],
        "disabled": true,
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}",
        },
      },
      "shadcn": {
        "type": "local",
        "command": ["mise", "exec", "npm:shadcn@latest", "--", "shadcn", "mcp"],
        "disabled": true,
      },
    },
  },
  "lsp": true,
}
