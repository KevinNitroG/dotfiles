{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "grouping": "auto",
    "image_preview": true,
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "enabled": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "attention": {
    "enabled": true,
    "volume": 1
  }
}
