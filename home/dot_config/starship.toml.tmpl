"$schema" = 'https://starship.rs/config-schema.json'

{{- $f := .starship.format }}
{{- $toolchain := $f.toolchain.common }}
{{- $devops := $f.devops.common }}
{{- if .isPersonal }}
{{- $toolchain = concat $toolchain $f.toolchain.personal }}
{{- $devops = concat $devops $f.devops.personal }}
{{- end }}
{{- if .isWork }}
{{- $toolchain = concat $toolchain (default (list) (index $f.toolchain.work .company)) }}
{{- $devops = concat $devops (default (list) (index $f.devops.work .company)) }}
{{- end }}
{{- $toolchain = uniq $toolchain }}
{{- $devops = uniq $devops }}
{{- $active := concat $toolchain $devops }}

format = """
[](surface0)\
$os\
$username\
[](bg:red fg:surface0)\
$hostname\
[](bg:peach fg:red)\
$directory\
[](fg:peach bg:yellow)\
$git_branch\
$git_status\
[](fg:yellow bg:green)\
{{ range $toolchain }}${{ . }}\
{{ end }}[](fg:green bg:blue)\
{{ range $devops }}${{ . }}\
{{ end }}[](fg:blue bg:lavender)\
$cmd_duration\
$sudo\
[ ](fg:lavender)\
$line_break$character"""

command_timeout = 999999 # mise may download
palette = 'catppuccin'
scan_timeout = 10000

{{- $palette := index .catppuccin.palettes .catppuccinFlavor }}
[palettes.catppuccin]
