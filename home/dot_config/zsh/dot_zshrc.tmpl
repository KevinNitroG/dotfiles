# $ZDOTDIR/.zshrc — interactive shells only.
#
# This file is deliberately thin: it loads oh-my-zsh, then sources every
# fragment in $ZDOTDIR/conf.d/*.zsh in order. Put new configuration in a
# numbered fragment there, not here.
#
# REF: https://unix.stackexchange.com/a/487889/612293

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

##########################################

# COMPLETIONS FPATH (must be set before oh-my-zsh runs compinit)
fpath=("$ZDOTDIR/completions" $fpath)

##########################################

# OH-MY-ZSH

{{- $plugins := .zsh.plugins.pre }}
{{- if eq .osFamily "arch" }}{{ $plugins = append $plugins "archlinux" }}{{- end }}
{{- if eq .chezmoi.os "darwin" }}{{ $plugins = append $plugins "macos" "brew" }}{{- end }}
{{- if eq .osFamily "ubuntu" }}{{ $plugins = append $plugins "ubuntu" }}{{- end }}
{{- if lookPath "dnf" }}{{ $plugins = append $plugins "dnf" }}{{- end }}
{{- $plugins = concat $plugins .zsh.plugins.mid.common }}
{{- if .isPersonal }}{{ $plugins = concat $plugins .zsh.plugins.mid.personal }}{{- end }}
{{- if .isWork }}{{ $plugins = concat $plugins (default (list) (index .zsh.plugins.mid.work .company)) }}{{- end }}
{{- $plugins = concat $plugins .zsh.plugins.post }}

plugins=(
{{- range $plugins | uniq }}
  {{ . }}
{{- end }}
)

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

_catppuccin_zsh_syntax_highlighting_zsh="$ZSH/custom/plugins/catppuccin-zsh-syntax-highlighting/themes/catppuccin_${CATPPUCCIN_FLAVOR:-mocha}-zsh-syntax-highlighting.zsh"
if [[ -f "$_catppuccin_zsh_syntax_highlighting_zsh" ]]; then
  source "$_catppuccin_zsh_syntax_highlighting_zsh"
fi
unset _catppuccin_zsh_syntax_highlighting_zsh

##########################################

# FRAGMENTS

for _conf in "$ZDOTDIR"/conf.d/*.zsh(N); do
  source "$_conf"
done
unset _conf

##########################################

# COMPLETION INIT (last — after every fpath entry and compdef is in place)

mkdir -p "${XDG_CACHE_HOME}/zsh"
autoload -Uz compinit && compinit -d "${XDG_CACHE_HOME}/zsh/zcompdump"
autoload -Uz bashcompinit && bashcompinit

# if (( $+commands[aws_completer] )); then
#   complete -C "$(command -v aws_completer)" aws
# fi

# if [[ -f "$XDG_CONFIG_HOME/.dart-cli-completion/zsh-config.zsh" ]]; then
#   source "$XDG_CONFIG_HOME/.dart-cli-completion/zsh-config.zsh"
# fi

##########################################

if (( $+commands[fastfetch] )); then
  fastfetch
fi
